# ─── Secrets ──────────────────────────────────────────────────────────────────
# NOTE: .env is already TRACKED in this repo (commit 2768ce7e) and so keeps
# being committed despite this rule. Listing a file here only stops *untracked*
# files from being added; it does not untrack an existing file.
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.yaml
secrets.yml

